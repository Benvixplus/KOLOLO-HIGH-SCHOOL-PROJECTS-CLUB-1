<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Kololians Spot Life</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <style>
        /* ===== RESET & BASE ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #6C3CE1;
            --primary-dark: #4A1F9E;
            --primary-light: #8B6CE6;
            --secondary: #FF6B35;
            --accent: #00D4AA;
            --bg-dark: #0F0A1A;
            --bg-card: #1A1329;
            --bg-input: #251D3A;
            --text-primary: #F0EDF5;
            --text-secondary: #B8AED0;
            --text-muted: #7A6E96;
            --border: #322B4A;
            --shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
            --radius: 16px;
            --radius-sm: 10px;
            --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--bg-dark);
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            background-image: radial-gradient(ellipse at 20% 50%, #1A1329 0%, #0F0A1A 70%);
        }

        /* ===== SCROLLBAR ===== */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: var(--bg-dark);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--primary);
            border-radius: 10px;
        }

        /* ===== APP CONTAINER ===== */
        #app {
            width: 100%;
            max-width: 1200px;
            min-height: 90vh;
            background: var(--bg-card);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
            overflow: hidden;
            position: relative;
            display: flex;
            flex-direction: column;
        }

        /* ===== AUTH SCREENS ===== */
        .auth-screen {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px 30px;
            min-height: 90vh;
            background: linear-gradient(145deg, var(--bg-card), var(--bg-dark));
        }

        .auth-screen .logo {
            font-size: 2.6rem;
            font-weight: 800;
            background: linear-gradient(135deg, var(--primary-light), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: -0.5px;
            margin-bottom: 4px;
        }

        .auth-screen .sub-logo {
            font-size: 0.95rem;
            color: var(--text-secondary);
            margin-bottom: 30px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .auth-screen .tagline {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-bottom: 30px;
            text-align: center;
            max-width: 400px;
            line-height: 1.6;
        }

        .auth-box {
            width: 100%;
            max-width: 420px;
            background: var(--bg-input);
            padding: 30px 28px;
            border-radius: var(--radius);
            border: 1px solid var(--border);
        }

        .auth-box h2 {
            font-size: 1.4rem;
            margin-bottom: 6px;
        }

        .auth-box .sub {
            color: var(--text-secondary);
            font-size: 0.85rem;
            margin-bottom: 22px;
        }

        .auth-box .form-group {
            margin-bottom: 16px;
        }

        .auth-box label {
            display: block;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-secondary);
            margin-bottom: 5px;
            letter-spacing: 0.3px;
        }

        .auth-box input,
        .auth-box select {
            width: 100%;
            padding: 12px 14px;
            background: var(--bg-dark);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            color: var(--text-primary);
            font-size: 0.95rem;
            transition: var(--transition);
            outline: none;
        }

        .auth-box input:focus,
        .auth-box select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(108, 60, 225, 0.25);
        }

        .auth-box input::placeholder {
            color: var(--text-muted);
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: var(--radius-sm);
            font-weight: 700;
            font-size: 0.95rem;
            cursor: pointer;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: #fff;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(108, 60, 225, 0.4);
        }

        .btn-secondary {
            background: var(--border);
            color: var(--text-primary);
        }

        .btn-secondary:hover {
            background: #3D3458;
        }

        .btn-accent {
            background: linear-gradient(135deg, var(--accent), #00B894);
            color: #0F0A1A;
        }

        .btn-accent:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0, 212, 170, 0.35);
        }

        .btn-danger {
            background: #E74C6F;
            color: #fff;
        }

        .btn-danger:hover {
            background: #C0395A;
        }

        .btn-sm {
            padding: 8px 16px;
            font-size: 0.8rem;
            width: auto;
        }

        .auth-switch {
            text-align: center;
            margin-top: 16px;
            color: var(--text-secondary);
            font-size: 0.9rem;
        }

        .auth-switch a {
            color: var(--primary-light);
            cursor: pointer;
            font-weight: 600;
            text-decoration: none;
        }

        .auth-switch a:hover {
            text-decoration: underline;
        }

        .subscription-badge {
            display: inline-block;
            background: var(--secondary);
            color: #fff;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 3px 12px;
            border-radius: 20px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        /* ===== DASHBOARD ===== */
        .dashboard {
            display: none;
            flex-direction: column;
            min-height: 90vh;
        }

        .dashboard.active {
            display: flex;
        }

        /* ===== TOP BAR ===== */
        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 24px;
            background: var(--bg-dark);
            border-bottom: 1px solid var(--border);
            flex-wrap: wrap;
            gap: 12px;
        }

        .topbar .brand {
            font-size: 1.3rem;
            font-weight: 800;
            background: linear-gradient(135deg, var(--primary-light), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .topbar .brand span {
            font-weight: 300;
            -webkit-text-fill-color: var(--text-muted);
            font-size: 0.8rem;
            margin-left: 6px;
        }

        .topbar .user-info {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .topbar .user-info .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.1rem;
            color: #fff;
            text-transform: uppercase;
        }

        .topbar .user-info .name {
            font-weight: 600;
            font-size: 0.95rem;
        }

        .topbar .user-info .sub-status {
            font-size: 0.7rem;
            color: var(--text-muted);
        }

        .topbar .user-info .sub-status.active {
            color: var(--accent);
        }

        .btn-logout {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-secondary);
            padding: 8px 16px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            font-size: 0.8rem;
            transition: var(--transition);
        }

        .btn-logout:hover {
            border-color: var(--secondary);
            color: var(--secondary);
        }

        /* ===== NAV ===== */
        .nav {
            display: flex;
            gap: 4px;
            padding: 12px 20px;
            background: var(--bg-dark);
            border-bottom: 1px solid var(--border);
            flex-wrap: wrap;
            overflow-x: auto;
        }

        .nav a {
            padding: 8px 18px;
            border-radius: 30px;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 600;
            transition: var(--transition);
            cursor: pointer;
            white-space: nowrap;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .nav a:hover {
            color: var(--text-primary);
            background: var(--bg-input);
        }

        .nav a.active {
            background: var(--primary);
            color: #fff;
            box-shadow: 0 4px 16px rgba(108, 60, 225, 0.3);
        }

        .nav a i {
            font-size: 0.9rem;
        }

        /* ===== CONTENT ===== */
        .content {
            flex: 1;
            padding: 24px;
            overflow-y: auto;
            max-height: calc(90vh - 130px);
        }

        .page {
            display: none;
            animation: fadeUp 0.3s ease;
        }

        .page.active {
            display: block;
        }

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(12px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .page-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .page-sub {
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-bottom: 24px;
        }

        /* ===== CARDS ===== */
        .card {
            background: var(--bg-input);
            border-radius: var(--radius);
            border: 1px solid var(--border);
            padding: 20px;
            margin-bottom: 20px;
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 14px;
            flex-wrap: wrap;
            gap: 8px;
        }

        .card-header h3 {
            font-size: 1.1rem;
            font-weight: 600;
        }

        .card-header .badge {
            background: var(--primary);
            color: #fff;
            padding: 2px 12px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
        }

        /* ===== GRID ===== */
        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .grid-3 {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        @media (max-width: 900px) {
            .grid-2,
            .grid-3 {
                grid-template-columns: 1fr;
            }
        }

        /* ===== CHAT / POSTS ===== */
        .post-input {
            display: flex;
            gap: 12px;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }

        .post-input textarea {
            flex: 1;
            padding: 14px;
            background: var(--bg-dark);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            color: var(--text-primary);
            font-size: 0.95rem;
            resize: vertical;
            min-height: 70px;
            font-family: inherit;
            outline: none;
            transition: var(--transition);
        }

        .post-input textarea:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(108, 60, 225, 0.2);
        }

        .post-input .btn {
            width: auto;
            padding: 12px 28px;
        }

        .post {
            background: var(--bg-dark);
            border-radius: var(--radius-sm);
            padding: 16px 18px;
            margin-bottom: 14px;
            border-left: 3px solid var(--primary);
            transition: var(--transition);
        }

        .post:hover {
            border-left-color: var(--secondary);
        }

        .post .post-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 6px;
            flex-wrap: wrap;
            gap: 4px;
        }

        .post .post-author {
            font-weight: 600;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .post .post-author .sub-badge {
            font-size: 0.6rem;
            background: var(--secondary);
            color: #fff;
            padding: 1px 10px;
            border-radius: 12px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .post .post-time {
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .post .post-content {
            font-size: 0.95rem;
            line-height: 1.6;
            margin: 8px 0 12px;
            word-break: break-word;
        }

        .post .post-actions {
            display: flex;
            gap: 18px;
            align-items: center;
            flex-wrap: wrap;
        }

        .post .post-actions button {
            background: transparent;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 5px;
            transition: var(--transition);
            padding: 4px 8px;
            border-radius: 6px;
        }

        .post .post-actions button:hover {
            color: var(--text-primary);
            background: var(--bg-input);
        }

        .post .post-actions button.liked {
            color: var(--secondary);
        }

        .post .post-actions .comment-toggle {
            color: var(--text-muted);
        }

        .post .comment-section {
            margin-top: 14px;
            padding-top: 14px;
            border-top: 1px solid var(--border);
            display: none;
        }

        .post .comment-section.open {
            display: block;
        }

        .post .comment-section .comment-input {
            display: flex;
            gap: 8px;
            margin-bottom: 10px;
        }

        .post .comment-section .comment-input input {
            flex: 1;
            padding: 10px 14px;
            background: var(--bg-dark);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            color: var(--text-primary);
            font-size: 0.9rem;
            outline: none;
        }

        .post .comment-section .comment-input input:focus {
            border-color: var(--primary);
        }

        .post .comment-section .comment-input .btn {
            width: auto;
            padding: 10px 18px;
        }

        .post .comment {
            background: var(--bg-input);
            padding: 10px 14px;
            border-radius: var(--radius-sm);
            margin-bottom: 8px;
            font-size: 0.9rem;
        }

        .post .comment .comment-meta {
            display: flex;
            gap: 12px;
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-bottom: 2px;
        }

        .post .comment .comment-meta strong {
            color: var(--text-primary);
        }

        /* ===== PORTFOLIO ===== */
        .portfolio-item {
            background: var(--bg-dark);
            border-radius: var(--radius-sm);
            padding: 16px 18px;
            margin-bottom: 14px;
            border: 1px solid var(--border);
            transition: var(--transition);
        }

        .portfolio-item:hover {
            border-color: var(--primary-light);
        }

        .portfolio-item .p-title {
            font-weight: 700;
            font-size: 1.05rem;
        }

        .portfolio-item .p-desc {
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin: 4px 0 8px;
        }

        .portfolio-item .p-meta {
            font-size: 0.75rem;
            color: var(--text-muted);
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
        }

        .portfolio-item .p-meta span {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        /* ===== NEWS ===== */
        .news-item {
            background: var(--bg-dark);
            border-radius: var(--radius-sm);
            padding: 16px 18px;
            margin-bottom: 14px;
            border-left: 3px solid var(--accent);
        }

        .news-item .n-title {
            font-weight: 700;
            font-size: 1.05rem;
        }

        .news-item .n-date {
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .news-item .n-body {
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-top: 4px;
            line-height: 1.5;
        }

        /* ===== PROFILE ===== */
        .profile-row {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

        .profile-row .profile-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: 700;
            color: #fff;
            text-transform: uppercase;
            flex-shrink: 0;
        }

        .profile-row .profile-details {
            flex: 1;
        }

        .profile-row .profile-details p {
            margin-bottom: 4px;
            color: var(--text-secondary);
        }

        .profile-row .profile-details p strong {
            color: var(--text-primary);
            font-weight: 600;
        }

